<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup="false" only stops cloud backup; device-to-device
     transfer still copies app data unless excluded here. Nothing of this app
     (settings, pinned cert, Keystore-wrapped secrets that cannot be decrypted
     on another device) should be copied. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="."/>
        <exclude domain="file" path="."/>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
        <exclude domain="external" path="."/>
    </device-transfer>
</data-extraction-rules>
