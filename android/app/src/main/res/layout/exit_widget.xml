<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="132dp"
        android:layout_height="match_parent"
        android:layout_gravity="end|bottom"
        android:alpha="0.85"
        android:contentDescription="@null"
        android:scaleType="fitEnd"
        android:src="@drawable/widget_art" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_dot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_dot" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="CYBERVULCAN"
                android:textColor="@color/widget_ok"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_refresh"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="Refresh"
                android:padding="5dp"
                android:src="@drawable/ic_widget_refresh" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_exit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Cybervulcan"
            android:textColor="@color/widget_title"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_detail"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_bypass"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:text="VPN bypass…"
            android:textColor="@color/widget_button_text"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
